# Copiar a .env.local: cp .env.example .env.local

DATABASE_URL=postgresql://roadie:roadie@localhost:5432/roadie_flow?schema=public

# Auth.js (generar con: openssl rand -base64 32)
AUTH_SECRET=

# Opcional (previews / producción)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Obligatorio para yarn db:seed (borra y recrea datos demo; solo local)
SEED_DEMO_DATA=true

# Credenciales admin demo (solo local; usadas por seed y E2E)
SEED_ADMIN_EMAIL=admin@roadie.local
SEED_ADMIN_PASSWORD=roadie-demo
