# Copiar a .env.local: cp .env.example .env.local

# Local: Docker Compose (ver yarn db:up)
DATABASE_URL=postgresql://roadie:roadie@localhost:5432/roadie_flow?schema=public

# Vercel + Neon inyecta DATABASE_URL y DATABASE_URL_UNPOOLED automáticamente.
# No hace falta en .env.local salvo que apuntes a Neon desde tu máquina.

# Auth.js (generar con: openssl rand -base64 32)
AUTH_SECRET=

# Opcional (previews / producción)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Obligatorio para yarn db:seed (borra y recrea datos demo; solo local)
SEED_DEMO_DATA=true

# Credenciales admin demo (local, E2E y preview en Vercel)
SEED_ADMIN_EMAIL=admin@roadie.local
SEED_ADMIN_PASSWORD=roadie-demo

# Roadie demo sin permisos CRUD (opcional; defaults abajo)
SEED_ROAD_STAFF_EMAIL=roadie@roadie.local
SEED_ROAD_STAFF_PASSWORD=roadie-demo
